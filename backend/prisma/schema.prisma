generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QueueStatus {
  MENUNGGU
  IN_WH
  PROSES
  SELESAI
  BATAL
}

enum QueueCategory {
  RECEIVING
  DELIVERY
}

enum AdminRole {
  ADMIN
  WAREHOUSE
  CS
}

enum WarehouseGate {
  WH1
  WH2
  DG
}

enum StoreType {
  STORE_IN
  STORE_OUT
}

enum EmployeePosition {
  FOREMAN
  TALLYMAN
  OPR_FORKLIFT
}

enum PickingStatus {
  MENUNGGU
  ON_PROCESS
  SELESAI
  BATAL
}

enum TruckType {
  CDD
  CDE
  FUSO
  WB
  FT20
  FT40
  OTHER
}

enum ScheduleItemStatus {
  PLANNED
  LINKED
  NO_SHOW
  NO_SHOW_CLOSED
}

model QueueEntry {
  id                    String        @id @default(uuid())
  customerId            String?
  customer              Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  gateId                String?
  gate                  Gate?         @relation(fields: [gateId], references: [id], onDelete: SetNull)
  pickerEmployeeId      String?
  pickerEmployee        Employee?     @relation(fields: [pickerEmployeeId], references: [id], onDelete: SetNull)
  category              QueueCategory
  driverName            String
  driverPhone           String?
  truckNumber           String
  truckType             TruckType?
  containerNumbers      String[]      @default([])
  transporter           String?
  transporterId         String?
  transporterRef        Transporter?  @relation(fields: [transporterId], references: [id], onDelete: SetNull)
  registerTime          DateTime      @default(now())
  inWhTime              DateTime?
  startTime             DateTime?
  finishTime            DateTime?
  slaWaitingMinutes     Int
  slaInWhProcessMinutes Int
  status                QueueStatus   @default(MENUNGGU)
  loadingType           String?
  notes                 String?
  notesFromWh           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  logs                  QueueLog[]

  // --- Relasi ke Schedule Pengiriman -------------------------------------
  // Tidak memakai @unique di sini karena slot harus dibebaskan saat BATAL.
  // Unik hanya untuk antrian non-BATAL, dijaga partial index
  // "queue_entry_active_schedule_item_unique" (lihat migrasi
  // 20261127120000_schedule_queue_integration).
  scheduleItemId String?
  scheduleItem   ShipmentScheduleItem? @relation(fields: [scheduleItemId], references: [id], onDelete: Restrict)

  // --- Snapshot nilai plan saat antrian dibuat ---------------------------
  // Disalin server dari database, bukan dari payload. Tidak pernah berubah
  // karena override di form antrian.
  plannedStart            DateTime?
  plannedFinish           DateTime?
  plannedPlateNumber      String?
  plannedTruckType        TruckType?
  plannedCustomerId       String?
  plannedCustomerName     String?
  plannedTransporterName  String?
  plannedDriverName       String?
  plannedContainerNumbers String[] @default([])

  // --- Penanda penutupan otomatis oleh sistem ----------------------------
  autoCompleted   Boolean   @default(false)
  autoCompletedAt DateTime?

  @@index([status, registerTime])
  @@index([truckNumber, registerTime])
  @@index([category, registerTime])
  @@index([customerId, registerTime])
  @@index([gateId])
  @@index([pickerEmployeeId])
  @@index([truckType])
  @@index([transporterId])
  @@index([scheduleItemId])
}

model QueueLog {
  id           String       @id @default(uuid())
  queueEntryId String
  type         String       @map("action")
  fromStatus   QueueStatus? @map("oldStatus")
  toStatus     QueueStatus? @map("newStatus")
  note         String?
  userName     String
  actorUserId  String?
  createdAt    DateTime     @default(now())
  entry        QueueEntry   @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  actorUser    AdminUser?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([queueEntryId, createdAt])
  @@index([actorUserId])
}

model Customer {
  id                String             @id @default(uuid())
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  entries           QueueEntry[]
  shipmentSchedules ShipmentSchedule[]
  pickingProgresses PickingProgress[]

  @@index([name])
}

model Employee {
  id              String            @id @default(uuid())
  nik             String            @unique @db.VarChar(10)
  name            String
  position        EmployeePosition
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  pickings        PickingProgress[]
  queueEntries    QueueEntry[]
  jobTransactions JobTransaction[]

  @@index([name])
  @@index([position])
}

model AdminUser {
  id                     String                @id @default(uuid())
  name                   String
  position               String
  phone                  String
  role                   AdminRole
  username               String                @unique
  passwordHash           String
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  logs                   QueueLog[]
  shipmentSchedules      ShipmentSchedule[]
  createdPickings        PickingProgress[]     @relation("PickingCreatedBy")
  updatedPickings        PickingProgress[]     @relation("PickingUpdatedBy")
  pickingLogs            PickingProgressLog[]
  createdDailyJobs       DailyJobActivity[]    @relation("DailyJobCreatedBy")
  updatedDailyJobs       DailyJobActivity[]    @relation("DailyJobUpdatedBy")
  dailyJobLogs           DailyJobActivityLog[]
  createdJobTransactions JobTransaction[]      @relation("JobTransactionCreatedBy")
  updatedJobTransactions JobTransaction[]      @relation("JobTransactionUpdatedBy")
  jobTransactionLogs     JobTransactionLog[]
  noShowClosedSchedules  ShipmentScheduleItem[] @relation("ScheduleItemNoShowClosedBy")
  appSettingsUpdated     AppSetting[]
  exportJobs             ExportJob[]

  @@index([role])
  @@index([username])
}

model Gate {
  id        String        @id @default(uuid())
  gateNo    String
  area      String
  warehouse WarehouseGate
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  entries   QueueEntry[]

  @@unique([gateNo, warehouse])
  @@map("gates")
}

model ShipmentSchedule {
  id              String                 @id @default(uuid())
  scheduleDate    DateTime               @db.Date
  storeType       StoreType
  customerId      String
  customer        Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdByUserId String?
  createdByUser   AdminUser?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  items           ShipmentScheduleItem[]

  @@index([scheduleDate, storeType])
  @@index([customerId, scheduleDate])
  @@index([createdByUserId])
}

model ShipmentScheduleItem {
  id             String           @id @default(uuid())
  scheduleId     String
  schedule       ShipmentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  truckType      TruckType
  truckTypeOther String?

  // --- Data truk (Phase 1) ----------------------------------------------
  // 1 baris = 1 truk. Kolom qty dihapus; lihat migrasi
  // 20261127120000_schedule_queue_integration.
  plateNumber      String?
  transporterId    String?
  transporter      Transporter? @relation(fields: [transporterId], references: [id], onDelete: SetNull)
  driverName       String?
  containerNumbers String[]     @default([])

  // Waktu gabungan scheduleDate + jam, supaya shift lewat tengah malam valid.
  plannedStart  DateTime?
  plannedFinish DateTime?

  // --- Siklus status terhadap Antrian Truk -------------------------------
  status               ScheduleItemStatus @default(PLANNED)
  noShowMarkedAt       DateTime?
  noShowClosedAt       DateTime?
  noShowClosedByUserId String?
  noShowClosedByUser   AdminUser?         @relation("ScheduleItemNoShowClosedBy", fields: [noShowClosedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  queueEntries QueueEntry[]

  @@index([scheduleId])
  @@index([truckType])
  @@index([plateNumber])
  @@index([plannedStart])
  @@index([status, plannedFinish])
  @@index([transporterId])
  @@index([noShowClosedByUserId])
}

model Transporter {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleItems ShipmentScheduleItem[]
  queueEntries  QueueEntry[]
}

model AppSetting {
  key             String   @id
  value           String
  updatedAt       DateTime @updatedAt
  updatedByUserId String?
  updatedByUser   AdminUser? @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

model PickingProgress {
  id                   String               @id @default(uuid())
  date                 DateTime
  customerId           String
  customer             Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  doNumber             String
  destination          String
  volumeCbm            Decimal?
  plTimeRelease        DateTime?
  pickingQty           Int
  pickedQty            Int                  @default(0)
  slaPerBarcodeMinutes Decimal              @default(2.5)
  startTime            DateTime?
  finishTime           DateTime?
  status               PickingStatus        @default(MENUNGGU)
  notesFromWh          String?
  createdById          String?
  createdBy            AdminUser?           @relation("PickingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById          String?
  updatedBy            AdminUser?           @relation("PickingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  pickerEmployeeId     String?
  pickerEmployee       Employee?            @relation(fields: [pickerEmployeeId], references: [id], onDelete: SetNull)
  logs                 PickingProgressLog[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([date])
  @@index([status])
  @@index([customerId])
  @@index([pickerEmployeeId])
}

model PickingProgressLog {
  id         String          @id @default(uuid())
  pickingId  String
  picking    PickingProgress @relation(fields: [pickingId], references: [id], onDelete: Cascade)
  action     String
  note       String?
  fromStatus PickingStatus?
  toStatus   PickingStatus?
  userId     String?
  user       AdminUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([pickingId])
  @@index([createdAt])
}

model DailyJobActivity {
  id           String   @id @default(uuid())
  activityDate DateTime @db.Date
  notes        String?

  createdById String?
  createdBy   AdminUser? @relation("DailyJobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   AdminUser? @relation("DailyJobUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions JobTransaction[]
  logs         DailyJobActivityLog[]

  @@unique([activityDate])
}

model JobTransaction {
  id                 String           @id @default(uuid())
  dailyJobActivityId String
  dailyJobActivity   DailyJobActivity @relation(fields: [dailyJobActivityId], references: [id], onDelete: Cascade)
  transactionDate    DateTime         @db.Date

  activityType String
  jobRole      String?

  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeName String

  truckType      String?
  truckTypeOther String?
  qty            Int     @default(1)

  totalDo     Int?
  totalMember Int?

  startAt  DateTime?
  finishAt DateTime?

  status       String  @default("DRAFT")
  confirmation String?
  cancelReason String?

  createdById String?
  createdBy   AdminUser? @relation("JobTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   AdminUser? @relation("JobTransactionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs JobTransactionLog[]

  @@index([dailyJobActivityId, startAt])
  @@index([transactionDate, status])
  @@index([transactionDate, activityType])
  @@index([employeeId])
}

model JobTransactionLog {
  id               String          @id @default(uuid())
  jobTransactionId String?
  jobTransaction   JobTransaction? @relation(fields: [jobTransactionId], references: [id], onDelete: SetNull)
  action           String
  note             String?
  fromStatus       String?
  toStatus         String?
  userId           String?
  user             AdminUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([jobTransactionId, createdAt])
  @@index([userId])
}

model DailyJobActivityLog {
  id                 String            @id @default(uuid())
  dailyJobActivityId String?
  dailyJobActivity   DailyJobActivity? @relation(fields: [dailyJobActivityId], references: [id], onDelete: SetNull)
  action             String
  note               String?
  userId             String?
  user               AdminUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())

  @@index([dailyJobActivityId, createdAt])
  @@index([userId])
}

enum ExportJobStatus {
  MENUNGGU
  PROSES
  SELESAI
  GAGAL
}

model ExportJob {
  id          String          @id @default(uuid())
  type        String
  status      ExportJobStatus @default(MENUNGGU)
  scopeLabel  String
  params      Json
  rowCount    Int             @default(0)
  fileName    String?
  filePath    String?
  fileSize    Int?
  error       String?
  createdById String?
  createdBy   AdminUser?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdByRole String?
  startedAt   DateTime?
  finishedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([createdById, createdAt])
  @@index([expiresAt])
}
